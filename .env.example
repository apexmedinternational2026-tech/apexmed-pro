# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# ── Supabase — Project Settings > API ────────────────────────────────────────

# Project URL. Client-safe (prefixed NEXT_PUBLIC_). Found in
# Supabase Dashboard > Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key. Client-safe (prefixed NEXT_PUBLIC_) — this key is subject
# to Row Level Security and is designed to be exposed to the browser.
# Found in Supabase Dashboard > Project Settings > API > Project API keys > anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER-ONLY — bypasses Row Level Security entirely.
# Must never be imported by, or reachable from, client-side code.
# Found in Supabase Dashboard > Project Settings > API > Project API keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by the Supabase CLI / migration
# tooling. Found in Supabase Dashboard > Project Settings > Database > Connection string.
SUPABASE_DB_URL=

# Supabase project ref (e.g. "abcdefghijklmnop"), used by the Supabase CLI to
# link this repo to the hosted project. Found in Project Settings > General > Reference ID.
SUPABASE_PROJECT_REF=

# ── Site config ───────────────────────────────────────────────────────────────

# Canonical public URL of the deployed site, used for generateMetadata(),
# canonical tags, sitemap.xml, and robots.txt. e.g. https://www.apexmed.example
NEXT_PUBLIC_SITE_URL=

# ── Lead capture / notifications ─────────────────────────────────────────────

# API key for the transactional email provider (e.g. Resend) used to notify
# staff of new leads and send confirmation emails to applicants.
# Obtained from your email provider's dashboard (e.g. resend.com/api-keys).
EMAIL_API_KEY=

# Destination address(es) for new-lead notification emails, comma-separated.
LEAD_NOTIFICATION_EMAIL=

# ── Lead capture / WhatsApp notifications (CallMeBot) ────────────────────────

# Personal API key from CallMeBot for the one WhatsApp number that should
# receive new-lead alerts. One-time setup: from that phone's WhatsApp, message
# +34 644 59 71 47 with "I allow callmebot to send me messages" and it replies
# with this key. See docs/RUNBOOK.md.
CALLMEBOT_API_KEY=

# The receiving WhatsApp number above, country code + digits only, no "+" and
# no spaces (e.g. 923001234567).
CALLMEBOT_PHONE=

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────

# Site key. Client-safe (prefixed NEXT_PUBLIC_) — this is meant to be
# public. Found in the Cloudflare dashboard under Turnstile > your widget.
# The widget on /contact silently no-ops without this set (see
# components/ui/turnstile-widget.tsx) — fine for local dev, but
# TURNSTILE_SECRET_KEY below being unset in production causes every
# submission to be rejected (lib/turnstile.ts fails closed, not open).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key. SERVER-ONLY. Found in the same Cloudflare dashboard page as
# the site key above — do not confuse the two.
TURNSTILE_SECRET_KEY=

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────

# DSN for this project, from sentry.io > Settings > Projects > <project> >
# Client Keys (DSN). Client-safe (prefixed NEXT_PUBLIC_) — a DSN is meant
# to be public; it only lets a client submit events, not read anything.
# Error monitoring simply doesn't initialize without this set.
NEXT_PUBLIC_SENTRY_DSN=

# ── Analytics / SEO (optional, add as adopted) ───────────────────────────────

# Google Search Console / Analytics verification or measurement ID.
# Client-safe (prefixed NEXT_PUBLIC_). Found in Google Search Console or GA4 admin.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification code (the "content" value
# from the meta tag Search Console gives you — not the whole tag).
# Client-safe. See docs/RUNBOOK.md for the full verification steps.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification code, same shape as the Google one above.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Vercel (set automatically on Vercel, only needed for local parity) ───────

# Deployment environment indicator: "development" | "preview" | "production".
VERCEL_ENV=

# ── Development tools ─────────────────────────────────────────────────────────

# Client-safe. Leave unset in production — /styleguide 404s on a production
# build unless this is exactly "true". Only ever set locally when you need
# to inspect the styleguide against a production build.
NEXT_PUBLIC_ENABLE_STYLEGUIDE=
